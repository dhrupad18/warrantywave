{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Probe WarrantyWave API health",
			"type": "shell",
			"command": "curl.exe",
			"args": [
				"-i",
				"--max-time",
				"5",
				"http://localhost:8080/actuator/health"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Probe registration validation",
			"type": "shell",
			"command": "curl.exe",
			"args": [
				"-i",
				"--max-time",
				"5",
				"-H",
				"Content-Type: application/json",
				"-d",
				"{}",
				"http://localhost:8080/api/auth/register"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check local backend health",
			"type": "shell",
			"command": "Invoke-WebRequest",
			"args": [
				"-UseBasicParsing",
				"-Uri",
				"http://localhost:8080/actuator/health",
				"-TimeoutSec",
				"5"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect API validation response",
			"type": "shell",
			"command": "Invoke-WebRequest",
			"args": [
				"-UseBasicParsing",
				"-Uri",
				"http://localhost:8080/api/auth/register",
				"-Method",
				"POST",
				"-ContentType",
				"application/json",
				"-Body",
				"{}",
				"-TimeoutSec",
				"5"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Read harmless API validation response",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-File",
				".probe-response.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify vehicle form change",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-File",
				".verify-frontend.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify API error handling",
			"type": "shell",
			"command": "mvn",
			"args": [
				"-f",
				"backend/pom.xml",
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Patch Angular security dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"install",
				"@angular/animations@^20.3.32",
				"@angular/common@^20.3.32",
				"@angular/compiler@^20.3.32",
				"@angular/core@^20.3.32",
				"@angular/forms@^20.3.32",
				"@angular/platform-browser@^20.3.32",
				"@angular/platform-browser-dynamic@^20.3.32",
				"@angular/router@^20.3.32",
				"@angular/cli@^20",
				"@angular-devkit/build-angular@^20",
				"@angular/compiler-cli@^20",
				"rxjs@^7.8.0",
				"zone.js@~0.15.0",
				"typescript@~5.9.3"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build WarrantyWave frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Test WarrantyWave frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"test",
				"--",
				"--watch=false",
				"--browsers=ChromeHeadless"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}